# ==========================================
# ShopSphere Environment Configuration
# ==========================================

# Database Connection (Default SQLite for local zero-config dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://postgres:yourpassword@db.example.com:5432/shopsphere?sslmode=require"

# Port & Server Configuration
PORT=3000
NODE_ENV="development"

# App & CORS URLs
APP_URL="http://localhost:3000"
FRONTEND_ORIGIN="http://localhost:3000"

# Session Security (Generate a 64+ char random hex string in production)
SESSION_SECRET="shopsphere-super-secure-production-ready-session-secret-key-2026-xyz"
COOKIE_DOMAIN="" # leave blank in local development

# Razorpay Payment Gateway Integration (Test Mode by default)
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_shopsphere_demo_key"
RAZORPAY_KEY_SECRET="shopsphere_test_secret_key_mock_safe"
RAZORPAY_WEBHOOK_SECRET="shopsphere_webhook_secret_verification_key"

# Image Storage (Optional Cloudinary / S3 / R2 provider)
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Email Provider (Optional SMTP / Resend / SendGrid)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="notifications@shopsphere.store"
SMTP_PASS=""
EMAIL_FROM="ShopSphere Orders <orders@shopsphere.store>"

# Gemini AI (Auto-injected in AI Studio Build)
GEMINI_API_KEY=""
